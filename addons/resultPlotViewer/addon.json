{
    "addonId": "konjugate.resultPlotViewer",
    "name": "Results Analysis",
    "version": "0.1.0",
    "apiVersion": 1,
    "kind": "resultVisualizer",
    "entry": "index.html",
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "permissions": [
        "results.read",
        "results.live.read",
        "timeline.read",
        "timeline.seek",
        "selection.read",
        "simulation.status.read",
        "simulation.pacing.read",
        "simulation.pacing.control"
    ],
    "contributes": {
        "toolstrip": [{
            "commandId": "openAnalysis",
            "label": "Analysis",
            "tooltip": "Open Results Analysis",
            "symbol": "⌁",
            "when": "resultsActive",
            "contexts": ["resultSession"]
        }]
    }
}
