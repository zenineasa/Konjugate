{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "batteryMotorDrive",
    "kind": "bundle",
    "name": "Battery-powered motor drive",
    "domains": [
        "electrical",
        "thermal"
    ],
    "description": "Wires a battery, a motor and a thermal mass together in one step. Select the three nodes (a Battery, a Motor and a Thermal mass), then click this bundle. It creates three edges: Armature dynamics (the battery's voltage drives the motor's current), Discharge (the motor's current lowers the battery's state of charge) and Resistive heating (the same current heats the thermal mass). The Armature dynamics and Resistive heating edges share one Winding resistance (Ω, default 2), so they cannot disagree about it: change it once and both follow.",
    "color": "#68a9cc",
    "endpoints": [
        {
            "id": "battery",
            "label": "Battery"
        },
        {
            "id": "motor",
            "label": "Motor"
        },
        {
            "id": "housing",
            "label": "Thermal mass"
        }
    ],
    "sharedParameters": [
        {
            "key": "resistance",
            "name": "Winding resistance",
            "symbol": "resistance",
            "value": 2,
            "unit": "Ω",
            "mode": "constant",
            "scope": "instance"
        }
    ],
    "edges": [
        {
            "name": "Armature dynamics",
            "from": "battery",
            "to": "motor",
            "ports": {
                "source": "voltage",
                "target": [
                    "current",
                    "angularVelocity"
                ]
            },
            "output": {
                "role": "target",
                "state": "current"
            },
            "latex": "\\frac{\\mathrm{sourceVoltage} - \\mathrm{resistance} \\cdot \\mathrm{targetCurrent} - \\mathrm{backEmfConstant} \\cdot \\mathrm{targetAngularVelocity}}{\\mathrm{inductance}}",
            "parameters": [
                {
                    "name": "Winding resistance",
                    "symbol": "resistance",
                    "shared": "resistance"
                },
                {
                    "name": "Back EMF constant",
                    "symbol": "backEmfConstant",
                    "value": 0.1,
                    "unit": "V·s/rad",
                    "mode": "constant"
                },
                {
                    "name": "Armature inductance",
                    "symbol": "inductance",
                    "value": 0.5,
                    "unit": "H",
                    "mode": "constant"
                }
            ],
            "description": "The battery's Voltage drives the motor's Armature current, opposed by the Winding resistance and by the back EMF the spinning rotor generates, and smoothed by the Armature inductance."
        },
        {
            "name": "Discharge",
            "from": "motor",
            "to": "battery",
            "ports": {
                "source": "current",
                "target": "stateOfCharge"
            },
            "output": {
                "role": "target",
                "state": "stateOfCharge"
            },
            "latex": "-\\mathrm{dischargeCoefficient} \\cdot \\mathrm{sourceCurrent}",
            "parameters": [
                {
                    "name": "Discharge coefficient",
                    "symbol": "dischargeCoefficient",
                    "value": 0.05,
                    "unit": "%/(A·s)",
                    "mode": "constant"
                }
            ],
            "description": "The motor's Armature current lowers the battery's State of charge, by the Discharge coefficient for each ampere-second."
        },
        {
            "name": "Resistive heating",
            "from": "motor",
            "to": "housing",
            "ports": {
                "source": "current",
                "target": "temperature"
            },
            "output": {
                "role": "target",
                "state": "temperature"
            },
            "latex": "\\frac{\\mathrm{resistance} \\cdot \\mathrm{sourceCurrent}^{2}}{\\mathrm{thermalCapacitance}}",
            "parameters": [
                {
                    "name": "Winding resistance",
                    "symbol": "resistance",
                    "shared": "resistance"
                },
                {
                    "name": "Thermal capacitance",
                    "symbol": "thermalCapacitance",
                    "value": 50,
                    "unit": "J/K",
                    "mode": "constant"
                }
            ],
            "description": "The same current heats the thermal mass through the shared Winding resistance (I²R), divided by the Thermal capacitance of the mass."
        }
    ]
}
