{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "shaftDynamics",
    "kind": "edge",
    "name": "Shaft dynamics",
    "domains": ["mechanical"],
    "description": "Drives a motor's own angular velocity from armature current, opposed by viscous friction and an external load torque. Connect from a Torque load to a Motor. Use this (rather than Rotational drive) when you want to model the motor's rotor fighting a known disturbance, not swinging a separately-tracked link.",
    "color": "#c78dbf",
    "ports": { "source": "torque", "target": ["current", "angularVelocity"] },
    "output": { "role": "target", "state": "angularVelocity" },
    "latex": "\\frac{\\mathrm{torqueConstant} \\cdot \\mathrm{targetCurrent} - \\mathrm{viscousFriction} \\cdot \\mathrm{targetAngularVelocity} - \\mathrm{sourceTorque}}{\\mathrm{rotorInertia}}",
    "parameters": [
        { "name": "Torque constant", "symbol": "torqueConstant", "value": 0.1, "unit": "N·m/A", "mode": "constant" },
        { "name": "Viscous friction", "symbol": "viscousFriction", "value": 0.02, "unit": "N·m·s/rad", "mode": "constant" },
        { "name": "Rotor inertia", "symbol": "rotorInertia", "value": 0.01, "unit": "kg·m²", "mode": "constant" }
    ]
}
