{
    "title": "A large stiff network: Rodas4 and BDF",
    "summary": "The scaling benchmark's thermal grid from 16 to 10,000 nodes over a horizon set by its slowest mode, cooling smoothly and heated in jumps every 2 s and every 0.25 s, under Stiff's two solvers, Rosenbrock (Rodas4) and BDF, at the same tolerance: the factorisations, Jacobians and evaluations each takes, its error, its engine time on the machine that ran it (not checked), and the size from which BDF takes less of each.",
    "methods": [
        { "method": "rodas4", "tolerance": { "relative": 1e-6, "absolute": 1e-9 } },
        { "method": "bdf", "tolerance": { "relative": 1e-6, "absolute": 1e-9 } }
    ],
    "jacobianComparison": { "family": "smooth", "size": 1024 },
    "families": [
        {
            "key": "smooth",
            "cases": [
                { "size": 16, "run": { "targetTime": 5, "globalTimeStep": 0.5, "outputInterval": 0.5 } },
                { "size": 64, "run": { "targetTime": 10, "globalTimeStep": 1, "outputInterval": 1 } },
                { "size": 256, "run": { "targetTime": 20, "globalTimeStep": 2, "outputInterval": 2 } },
                { "size": 1024, "run": { "targetTime": 40, "globalTimeStep": 4, "outputInterval": 4 } },
                { "size": 4096, "run": { "targetTime": 100, "globalTimeStep": 10, "outputInterval": 10 } },
                { "size": 10000, "run": { "targetTime": 200, "globalTimeStep": 20, "outputInterval": 20 } }
            ]
        },
        {
            "key": "jumps",
            "jumps": { "amplitude": 5, "switchEvery": 2 },
            "reference": { "method": "rodas4", "tolerance": { "relative": 1e-10, "absolute": 1e-12 } },
            "cases": [
                { "size": 256, "run": { "targetTime": 40, "globalTimeStep": 4, "outputInterval": 4 } },
                { "size": 1024, "run": { "targetTime": 40, "globalTimeStep": 4, "outputInterval": 4 } }
            ]
        },
        {
            "key": "frequentJumps",
            "jumps": { "amplitude": 5, "switchEvery": 0.25 },
            "reference": { "method": "rodas4", "tolerance": { "relative": 1e-10, "absolute": 1e-12 } },
            "cases": [
                { "size": 256, "run": { "targetTime": 40, "globalTimeStep": 4, "outputInterval": 4 } },
                { "size": 1024, "run": { "targetTime": 40, "globalTimeStep": 4, "outputInterval": 4 } }
            ]
        }
    ],
    "thresholds": {
        "smooth16ErrorRodas4": { "max": 2e-7 },
        "smooth16ErrorBdf": { "max": 2e-6 },
        "smooth16FactorisationRatio": { "min": 1.3 },
        "smooth16JacobianRatio": { "min": 5.5 },
        "smooth64ErrorRodas4": { "max": 2e-7 },
        "smooth64ErrorBdf": { "max": 3e-6 },
        "smooth64FactorisationRatio": { "min": 1.1 },
        "smooth64JacobianRatio": { "min": 5.6 },
        "smooth256ErrorRodas4": { "max": 1e-7 },
        "smooth256ErrorBdf": { "max": 4e-6 },
        "smooth256FactorisationRatio": { "min": 1.2 },
        "smooth256JacobianRatio": { "min": 5.7 },
        "smooth1024ErrorRodas4": { "max": 3e-8 },
        "smooth1024ErrorBdf": { "max": 5e-6 },
        "smooth1024FactorisationRatio": { "min": 1.2 },
        "smooth1024JacobianRatio": { "min": 5.5 },
        "smooth4096ErrorRodas4": { "max": 6e-9 },
        "smooth4096ErrorBdf": { "max": 2e-5 },
        "smooth4096FactorisationRatio": { "min": 1.2 },
        "smooth4096JacobianRatio": { "min": 5.7 },
        "smooth10000ErrorRodas4": { "max": 3e-9 },
        "smooth10000ErrorBdf": { "max": 5e-6 },
        "smooth10000FactorisationRatio": { "min": 1.2 },
        "smooth10000JacobianRatio": { "min": 5.8 },
        "jumps256ErrorRodas4": { "max": 2e-6 },
        "jumps256ErrorBdf": { "max": 6e-6 },
        "jumps256FactorisationRatio": { "min": 1.4 },
        "jumps256JacobianRatio": { "min": 42.4 },
        "jumps1024ErrorRodas4": { "max": 4e-5 },
        "jumps1024ErrorBdf": { "max": 2e-4 },
        "jumps1024FactorisationRatio": { "min": 1.3 },
        "jumps1024JacobianRatio": { "min": 37.2 },
        "frequentJumps256ErrorRodas4": { "max": 7e-6 },
        "frequentJumps256ErrorBdf": { "max": 8e-5 },
        "frequentJumps256FactorisationRatio": { "min": 0.6 },
        "frequentJumps256JacobianRatio": { "min": 84.2 },
        "frequentJumps1024ErrorRodas4": { "max": 3e-5 },
        "frequentJumps1024ErrorBdf": { "max": 2e-3 },
        "frequentJumps1024FactorisationRatio": { "min": 0.6 },
        "frequentJumps1024JacobianRatio": { "min": 72 },
        "smooth1024EvaluationRatioRodas4": { "max": 0.55 },
        "smooth1024ErrorRatioRodas4": { "max": 1.2 },
        "smooth1024EvaluationRatioBdf": { "max": 0.9 },
        "smooth1024ErrorRatioBdf": { "max": 1.2 }
    }
}
