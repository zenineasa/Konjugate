      "id": "aboutPointThree",
      "family": "history",
      "domain": "electrical",
      "style": "terse",
      "split": "test",
      "model": "singleJointActuator",
      "request": "about 0.3",
      "history": [
        {
          "request": "Change the load",
          "outcome": "Asked: What load torque (in N·m) should Load torque be set to?"
        }
      ],
      "expect": {
        "touches": [
          "Load torque"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Load torque",
            "symbol": "torque",
            "initialValue": 0.3,
            "unit": "N·m"
          }
        ]
      }
