      "domain": "electrical",
      "style": "plain",
      "split": "test",
      "model": "wheeledRobotDrivetrain",
      "request": "Add a second motor called Left motor with a current of 0 A and an angular velocity of 0 rad/s, and connect the drive supply to it.",
