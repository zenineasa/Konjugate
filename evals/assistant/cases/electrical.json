    {
      "id": "coldStartScenario",
      "family": "multiStep",
      "domain": "electrical",
      "style": "multiPart",
      "split": "test",
      "model": "batteryPoweredJoint",
      "request": "For the next test the pack is only charged to 60%, the ambient is a cold 5 °C, and the motor housing starts at the same temperature as the ambient.",
      "expect": {
        "touches": [
          "Battery",
          "Ambient air",
          "Motor housing"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Battery",
            "symbol": "stateOfCharge",
            "initialValue": 60,
            "unit": "%"
          },
          {
            "op": "state",
            "node": "Ambient air",
            "symbol": "temperature",
            "initialValue": 278.15,
            "unit": "K"
          },
          {
            "op": "state",
            "node": "Motor housing",
            "symbol": "temperature",
            "initialValue": 278.15,
            "unit": "K"
          }
        ]
      }
    },
    {
