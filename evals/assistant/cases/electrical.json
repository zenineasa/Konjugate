{
  "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
  "cases": [
    {
      "id": "dcSupply12",
      "family": "updateValue",
      "domain": "electrical",
      "style": "plain",
      "split": "test",
      "model": "singleJointActuator",
      "request": "Set the DC supply voltage to 12 V.",
      "expect": {
        "touches": [
          "DC supply"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "DC supply",
            "symbol": "voltage",
            "initialValue": 12,
            "unit": "V"
          }
        ]
      }
    },
    {
      "id": "loadTorqueHalf",
      "family": "updateValue",
      "domain": "electrical",
      "style": "terse",
      "split": "test",
      "model": "singleJointActuator",
      "request": "Load torque 0.5 N·m.",
      "expect": {
        "touches": [
          "Load torque"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Load torque",
            "symbol": "torque",
            "initialValue": 0.5,
            "unit": "N·m"
          }
        ]
      }
    },
    {
      "id": "armatureResistance",
      "family": "updateParameter",
      "domain": "electrical",
      "style": "conversational",
      "split": "test",
      "model": "singleJointActuator",
      "request": "Could you raise the armature resistance to 3 ohms?",
      "expect": {
        "touches": [
          "Armature dynamics"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "DC supply",
            "to": "Motor",
            "symbol": "resistance",
            "value": 3
          }
        ]
      }
    },
    {
      "id": "halfRotorInertia",
      "family": "updateParameter",
      "domain": "electrical",
      "style": "indirect",
      "split": "test",
      "model": "singleJointActuator",
      "request": "The motor is too sluggish. It has 0.01 kg·m² of rotor inertia at the moment and I want half of that.",
      "expect": {
        "touches": [
          "Shaft dynamics"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Load torque",
            "to": "Motor",
            "symbol": "rotorInertia",
            "value": 0.005
          }
        ]
      }
    },
    {
      "id": "bumpSupply",
      "family": "updateValue",
      "domain": "electrical",
      "style": "loose",
      "split": "test",
      "model": "singleJointActuator",
      "request": "bump the supply up to 36V",
      "expect": {
        "touches": [
          "DC supply"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "DC supply",
            "symbol": "voltage",
            "initialValue": 36,
            "unit": "V"
          }
        ]
      }
    },
    {
      "id": "viscousFrictionTypos",
      "family": "updateParameter",
      "domain": "electrical",
      "style": "typos",
      "split": "test",
      "model": "singleJointActuator",
      "request": "Increse the viscus friction on the shaft to 0.05",
      "expect": {
        "touches": [
          "Shaft dynamics"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Load torque",
            "to": "Motor",
            "symbol": "viscousFriction",
            "value": 0.05
          }
        ]
      }
    },
    {
      "id": "noBackEmf",
      "family": "setEquation",
      "domain": "electrical",
      "style": "verbose",
      "split": "test",
      "model": "singleJointActuator",
      "request": "For a stalled-rotor test I want the armature dynamics without the back-EMF term: just the supply voltage minus the resistance times the current, divided by the inductance.",
      "expect": {
        "touches": [
          "Armature dynamics"
        ],
        "assertions": [
          {
            "op": "edgeEquation",
            "from": "DC supply",
            "to": "Motor",
            "uses": [
              "sourceVoltage",
              "resistance",
              "inductance"
            ],
            "excludes": [
              "backEmfConstant"
            ],
            "changed": true
          }
        ]
      }
    },
    {
      "id": "logicRail",
      "family": "addNode",
      "domain": "electrical",
      "style": "plain",
      "split": "test",
      "model": "blank",
      "request": "Add a voltage source called Logic rail with a voltage of 5 V.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 1
          },
          {
            "op": "hasNode",
            "name": "Logic rail"
          },
          {
            "op": "state",
            "node": "Logic rail",
            "initialValue": 5,
            "unit": "V"
          }
        ]
      }
    },
    {
      "id": "leftMotor",
