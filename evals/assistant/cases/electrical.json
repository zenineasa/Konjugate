            "count": 1
          },
          {
            "op": "state",
            "node": "Left motor",
            "initialValue": 0,
            "unit": "A"
          },
          {
            "op": "state",
            "node": "Left motor",
            "initialValue": 0,
            "unit": "rad/s"
          },
          {
            "op": "hasEdge",
            "from": "Drive supply",
            "to": "Left motor"
          },
          {
            "op": "edgeEquation",
            "from": "Drive supply",
            "to": "Left motor",
            "uses": []
          }
        ]
      }
    },
    {
      "id": "bearingFrictionOff",
      "family": "enableDisable",
      "domain": "electrical",
      "style": "plain",
      "split": "test",
      "model": "wheeledRobotDrivetrain",
      "request": "Switch off the bearing friction.",
