    {
      "id": "g1184MultiStepFinanceCompany",
      "family": "multiStep",
      "domain": "finance",
      "style": "verbose",
      "split": "test",
      "model": "financeCompany",
      "request": "I'm preparing a new scenario for the review. The inputs are: Operating costs cost rate 210000 USD/month, Capital market monthly return rate 0.015 1/month and Operating account balance 500000 USD. Please apply all of them and leave the rest of the model alone.",
      "expect": {
        "touches": [
          "Operating costs",
          "Capital market",
          "Operating account"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Operating costs",
            "symbol": "costRate",
            "initialValue": 210000,
            "unit": "USD/month"
          },
          {
            "op": "state",
            "node": "Capital market",
            "symbol": "returnRate",
            "initialValue": 0.015,
            "unit": "1/month"
          },
          {
            "op": "state",
            "node": "Operating account",
            "symbol": "balance",
            "initialValue": 500000,
            "unit": "USD"
          }
        ]
      }
    },
