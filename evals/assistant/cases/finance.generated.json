    {
      "id": "g1442SetEquationFinanceCompany",
      "family": "setEquation",
      "domain": "finance",
      "style": "indirect",
      "split": "test",
      "model": "financeCompany",
      "request": "Cost payments should only act once the first 1 hour are over.",
      "expect": {
        "touches": [
          "Cost payments"
        ],
        "assertions": [
          {
            "op": "edgeEquation",
            "from": "Operating costs",
            "to": "Operating account",
            "uses": [
              "sourceCostRate",
              "begin{cases}",
              "3600"
            ],
            "changed": true
          }
        ]
      }
    },
