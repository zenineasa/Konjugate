    {
      "id": "g0520UpdateParameterFinanceCompany",
      "family": "updateParameter",
      "domain": "finance",
      "style": "conversational",
      "split": "test",
      "model": "financeCompany",
      "request": "Would you change the monthly payment on both Loan repayment and Debt service to 18000 USD/month? Thanks.",
      "expect": {
        "touches": [
          "Loan repayment",
          "Debt service"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Operating account",
            "to": "Business loan",
            "symbol": "monthlyPayment",
            "value": 18000,
            "all": true,
            "either": true
          }
        ]
      }
