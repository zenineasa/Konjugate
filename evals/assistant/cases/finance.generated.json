  "cases": [
    {
      "id": "g0301UnitsFinanceCompany",
      "family": "units",
      "domain": "finance",
      "style": "typos",
      "split": "test",
      "model": "financeCompany",
      "request": "Wouuld you change the revenue rate to 150k per month? Thanks.",
      "expect": {
        "touches": [
          "Sales"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Sales",
            "symbol": "revenueRate",
            "initialValue": 150000,
            "unit": "USD/month",
            "tolerance": 0.000001
          }
        ]
      }
    },
