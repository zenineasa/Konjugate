    {
      "id": "savingsChecking",
      "family": "multiStep",
      "domain": "finance",
      "style": "verbose",
      "split": "test",
      "model": "blank",
      "request": "Make two accounts, Savings holding 1000 USD and Checking holding 200 USD, and add a flow from Savings to Checking where Checking gains 1% of the Savings balance each month.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 2
          },
          {
            "op": "state",
            "node": "Savings",
            "initialValue": 1000,
            "unit": "USD"
          },
          {
            "op": "state",
            "node": "Checking",
            "initialValue": 200,
            "unit": "USD"
          },
          {
            "op": "hasEdge",
            "from": "Savings",
            "to": "Checking"
          },
          {
            "op": "edgeParameter",
            "from": "Savings",
            "to": "Checking",
            "value": 0.01
          },
          {
            "op": "edgeEquation",
            "from": "Savings",
            "to": "Checking",
            "uses": [
              "source"
            ]
          }
        ]
      }
    },
    {
      "id": "balanceSheet",
      "family": "multiStep",
      "domain": "finance",
      "style": "multiPart",
      "split": "test",
      "model": "financeCompany",
      "request": "Set the account to 100000 USD, the portfolio to 2 million and the loan to 500000.",
      "expect": {
        "touches": [
          "Operating account",
          "Investment portfolio",
          "Business loan"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Operating account",
            "symbol": "balance",
            "initialValue": 100000,
            "unit": "USD"
          },
          {
            "op": "state",
            "node": "Investment portfolio",
            "symbol": "value",
            "initialValue": 2000000
          },
          {
            "op": "state",
            "node": "Business loan",
            "symbol": "principal",
            "initialValue": 500000
          }
        ]
      }
    },
