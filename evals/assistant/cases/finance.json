    {
      "id": "revenue150k",
      "family": "history",
      "domain": "finance",
      "style": "conversational",
      "split": "test",
      "model": "financeCompany",
      "request": "Make it 150000",
      "history": [
        {
          "request": "What if revenue changed?",
          "outcome": "Asked: What revenue rate (in USD/month) should Sales use?"
        }
      ],
      "expect": {
        "touches": [
          "Sales"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Sales",
            "symbol": "revenueRate",
            "initialValue": 150000,
            "unit": "USD/month"
          }
        ]
      }
    },
    {
      "id": "recession",
      "family": "multiStep",
      "domain": "finance",
      "style": "verbose",
      "split": "test",
      "model": "financeCompany",
      "request": "Scenario: recession. Sales fall to 120k a month, costs stay as they are, the market return goes negative at -1% a month, and the loan principal is unchanged.",
      "expect": {
        "touches": [
          "Sales",
          "Capital market"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Sales",
            "symbol": "revenueRate",
            "initialValue": 120000,
            "unit": "USD/month"
          },
          {
            "op": "state",
            "node": "Capital market",
            "symbol": "returnRate",
            "initialValue": -0.01
          }
        ]
      }
    },
    {
      "id": "salesPerYear",
      "family": "units",
      "domain": "finance",
      "style": "plain",
      "split": "test",
      "model": "financeCompany",
      "request": "Set the sales to 2 million dollars a year.",
      "expect": {
        "touches": [
          "Sales"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Sales",
            "symbol": "revenueRate",
            "initialValue": 166666.667,
            "unit": "USD/month",
            "tolerance": 0.0001
          }
        ]
      }
    },
