      "domain": "fluid",
      "style": "plain",
      "split": "test",
      "model": "pumpSuctionHydraulics",
      "request": "Set the tank pressure to 101325 Pa.",
      "expect": {
        "touches": [
          "Tank"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Tank",
            "symbol": "pressure",
            "initialValue": 101325,
            "unit": "Pa"
          }
        ]
      }
    },
