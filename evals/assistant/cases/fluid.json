            "initialValue": 3,
            "unit": "m"
          },
          {
            "op": "state",
            "node": "Pump",
            "symbol": "pressure",
            "initialValue": 95000,
            "unit": "Pa"
          },
          {
            "op": "state",
            "node": "Tank",
            "symbol": "pressure",
            "initialValue": 101325,
            "unit": "Pa"
          }
        ]
