      "domain": "fluid",
      "style": "indirect",
      "split": "test",
      "model": "pumpSuctionHydraulics",
      "request": "We upgraded to a bigger tank, and its capacitance is now 0.0005 m³/Pa.",
      "expect": {
        "touches": [
