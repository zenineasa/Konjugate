      "domain": "fluid",
      "style": "plain",
      "split": "test",
      "model": "pumpSuctionHydraulics",
      "request": "Add a Relief valve junction at 150000 Pa and connect the pump to it.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 1
          },
          {
            "op": "state",
            "node": "Relief valve junction",
            "initialValue": 150000,
            "unit": "Pa"
          },
          {
            "op": "hasEdge",
            "from": "Pump",
            "to": "Relief valve junction",
            "either": true
          },
          {
            "op": "edgeEquation",
            "from": "Pump",
            "to": "Relief valve junction",
            "uses": [],
            "either": true
          }
        ]
      }
