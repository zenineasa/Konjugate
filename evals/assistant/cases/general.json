    {
      "id": "blankConnectedPair",
      "family": "multiStep",
      "domain": "general",
      "style": "verbose",
      "split": "test",
      "model": "blank",
      "request": "Add two thermal nodes, Hot block at 400 K and Cold block at 300 K, and connect them with a heat flow from Hot block to Cold block with a conductance of 5 W/K.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 2
          },
          {
            "op": "edgesAdded",
            "count": 1
          },
          {
            "op": "state",
            "node": "Hot block",
            "initialValue": 400,
            "unit": "K"
          },
          {
            "op": "state",
            "node": "Cold block",
            "initialValue": 300,
            "unit": "K"
          },
          {
            "op": "hasEdge",
            "from": "Hot block",
            "to": "Cold block"
          },
          {
            "op": "edgeParameter",
            "from": "Hot block",
            "to": "Cold block",
            "value": 5,
            "unit": "W/K"
          },
          {
            "op": "edgeEquation",
            "from": "Hot block",
            "to": "Cold block",
            "uses": [
              "source",
              "target"
            ]
          }
        ]
      }
    },
