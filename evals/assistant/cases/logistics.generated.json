    {
      "id": "g1439SetEquationLogisticsPortNetwork",
      "family": "setEquation",
      "domain": "logistics",
      "style": "terse",
      "split": "test",
      "model": "logisticsPortNetwork",
      "request": "Deliver A to Zone 1 delayed 3600 s.",
      "expect": {
        "touches": [
          "Deliver A to Zone 1"
        ],
        "assertions": [
          {
            "op": "edgeEquation",
            "from": "Warehouse A",
            "to": "Zone 1",
            "uses": [
              "secondsPerDay",
              "begin{cases}",
              "3600"
            ],
            "changed": true
          }
        ]
