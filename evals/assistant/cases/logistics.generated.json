        "assertions": [
          {
            "op": "state",
            "node": "Port",
            "symbol": "yard",
            "initialValue": 2400,
            "unit": "TEU"
          },
          {
            "op": "state",
            "node": "Zone 2",
            "symbol": "backlog",
            "initialValue": 160,
            "unit": "TEU"
          },
          {
            "op": "state",
            "node": "Zone 3",
            "symbol": "backlog",
            "initialValue": 120,
            "unit": "TEU"
          }
        ]
      }
    },
