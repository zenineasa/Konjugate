    {
      "id": "g1180MultiStepLogisticsPortNetwork",
      "family": "multiStep",
      "domain": "logistics",
      "style": "conversational",
      "split": "test",
      "model": "logisticsPortNetwork",
      "request": "Could you set the Zone 2 backlog to 15 TEU and the Port yard stock to 2400 TEU and the Warehouse B on hand to 67.5 TEU, please?",
      "expect": {
        "touches": [
          "Zone 2",
          "Port",
          "Warehouse B"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Zone 2",
            "symbol": "backlog",
            "initialValue": 15,
            "unit": "TEU"
          },
          {
            "op": "state",
            "node": "Port",
            "symbol": "yard",
            "initialValue": 2400,
            "unit": "TEU"
          },
          {
            "op": "state",
            "node": "Warehouse B",
            "symbol": "onHand",
            "initialValue": 67.5,
            "unit": "TEU"
          }
        ]
      }
    },
    {
      "id": "g1182MultiStepLogisticsPortNetwork",
      "family": "multiStep",
      "domain": "logistics",
