  "cases": [
    {
      "id": "portYard400",
      "family": "updateValue",
      "domain": "logistics",
      "style": "plain",
      "split": "test",
      "model": "logisticsPortNetwork",
      "request": "Set the Port yard to 400 TEU.",
      "expect": {
        "touches": [
          "Port"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Port",
            "symbol": "yard",
            "initialValue": 400,
            "unit": "TEU"
          }
        ]
      }
    },
