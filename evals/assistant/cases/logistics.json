    {
      "id": "vesselDelay",
      "family": "multiStep",
      "domain": "logistics",
      "style": "verbose",
      "split": "test",
      "model": "logisticsPortNetwork",
      "request": "A vessel delay means the yard is nearly empty, so set the Port yard to 20 TEU. The two warehouses are also running low, so put Warehouse A at 100 TEU on hand and Warehouse B at 40.",
      "expect": {
        "touches": [
          "Port",
          "Warehouse A",
          "Warehouse B"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Port",
            "symbol": "yard",
            "initialValue": 20,
            "unit": "TEU"
          },
          {
            "op": "state",
            "node": "Warehouse A",
            "symbol": "onHand",
            "initialValue": 100,
            "unit": "TEU"
          },
          {
            "op": "state",
            "node": "Warehouse B",
            "symbol": "onHand",
            "initialValue": 40,
            "unit": "TEU"
          }
        ]
      }
    },
