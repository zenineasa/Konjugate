    {
      "id": "couplerLonger",
      "family": "updateParameter",
      "domain": "mechanical",
      "style": "verbose",
      "split": "test",
      "model": "fourBarLinkage",
      "request": "The coupler rod is longer in reality than I modelled: 3.2 m at rest instead of 3. Please update both the X and Y couplings.",
