        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Crank pin B",
            "to": "Coupler-rocker pin C",
            "symbol": "restLength",
            "value": 3.2,
            "unit": "m",
            "all": true
          }
        ]
      }
