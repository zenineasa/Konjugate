  "cases": [
    {
      "id": "springStiffness10",
      "family": "updateParameter",
      "domain": "mechanical",
      "style": "plain",
      "split": "test",
      "model": "springMassDamper",
      "request": "Set the spring stiffness to 10 N/m.",
      "expect": {
        "touches": [
          "Spring force"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Fixed support",
            "to": "Suspended mass",
            "symbol": "stiffness",
            "value": 10,
            "unit": "N/m"
          }
        ]
      }
    },
    {
      "id": "damping12",
      "family": "updateParameter",
      "domain": "mechanical",
      "style": "terse",
      "split": "test",
      "model": "springMassDamper",
      "request": "Damping 1.2 N·s/m.",
      "expect": {
        "touches": [
          "Damper force"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Fixed support",
            "to": "Suspended mass",
            "symbol": "dampingCoefficient",
            "value": 1.2
          }
        ]
      }
    },
