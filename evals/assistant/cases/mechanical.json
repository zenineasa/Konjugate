      "domain": "mechanical",
      "style": "plain",
      "split": "test",
      "model": "blank",
      "request": "Add a mechanical boundary called Ceiling with a displacement of 0 m and a velocity of 0 m/s.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 1
          },
          {
            "op": "hasNode",
            "name": "Ceiling"
          },
          {
            "op": "state",
            "node": "Ceiling",
            "initialValue": 0,
            "unit": "m"
          },
          {
            "op": "state",
            "node": "Ceiling",
            "initialValue": 0,
            "unit": "m/s"
          }
        ]
      }
