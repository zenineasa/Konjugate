    {
      "id": "addPayload",
      "family": "multiStep",
      "domain": "mechanical",
      "style": "verbose",
      "split": "test",
      "model": "springMassDamper",
      "request": "I want to hang a second mass called Payload below the suspended mass (displacement 0 m, velocity 0 m/s), connected to it with a spring of stiffness 50 N/m.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 1
          },
          {
            "op": "state",
            "node": "Payload",
            "initialValue": 0,
            "unit": "m"
          },
          {
            "op": "hasEdge",
            "from": "Suspended mass",
            "to": "Payload",
            "either": true
          },
          {
            "op": "edgeParameter",
            "from": "Suspended mass",
            "to": "Payload",
            "symbol": "stiffness",
            "value": 50,
            "unit": "N/m",
            "either": true
          },
          {
            "op": "edgeEquation",
            "from": "Suspended mass",
            "to": "Payload",
            "uses": [],
            "either": true
          }
        ]
      }
    },
