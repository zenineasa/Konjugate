    {
      "id": "cartAndWall",
      "family": "multiStep",
      "domain": "mechanical",
      "style": "verbose",
      "split": "test",
      "model": "blank",
      "request": "Create a mass called Cart at 0 m with a velocity of 0 m/s, and a fixed wall called Wall at 2 m with no velocity, connected by a spring with a stiffness of 100 N/m.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 2
          },
          {
            "op": "state",
            "node": "Cart",
            "initialValue": 0,
            "unit": "m"
          },
          {
            "op": "state",
            "node": "Wall",
            "initialValue": 2,
            "unit": "m"
          },
          {
            "op": "hasEdge",
            "from": "Cart",
            "to": "Wall",
            "either": true
          },
          {
            "op": "edgeParameter",
            "from": "Cart",
            "to": "Wall",
            "value": 100,
            "unit": "N/m",
            "either": true
          },
          {
            "op": "edgeEquation",
            "from": "Cart",
            "to": "Wall",
            "uses": [],
            "either": true
          }
        ]
      }
    },
    {
      "id": "tuneSuspension",
      "family": "multiStep",
      "domain": "mechanical",
      "style": "multiPart",
      "split": "test",
      "model": "springMassDamper",
      "request": "Set the spring stiffness to 6 N/m, the damping to 0.8 N·s/m and start the mass at 0.2 m.",
      "expect": {
        "touches": [
          "Spring force",
          "Damper force",
          "Suspended mass"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Fixed support",
            "to": "Suspended mass",
            "symbol": "stiffness",
            "value": 6
          },
          {
            "op": "edgeParameter",
            "from": "Fixed support",
            "to": "Suspended mass",
            "symbol": "dampingCoefficient",
            "value": 0.8
          },
          {
            "op": "state",
            "node": "Suspended mass",
            "symbol": "displacement",
            "initialValue": 0.2,
            "unit": "m"
          }
        ]
      }
    },
