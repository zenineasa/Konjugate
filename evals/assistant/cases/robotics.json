    {
      "id": "proportionalOnly",
      "family": "setEquation",
      "domain": "robotics",
      "style": "verbose",
      "split": "test",
      "model": "positionControlledJoint",
      "request": "I want the joint controller to be purely proportional. Rewrite the position control law so it is only the gain times the angle error, with no rate term.",
      "expect": {
        "touches": [
          "Position control"
        ],
        "assertions": [
          {
            "op": "edgeEquation",
            "from": "Joint link",
            "to": "Voltage source",
            "uses": [
              "gain",
              "setpointAngle",
              "sourceAngle"
            ],
            "excludes": [
              "rateGain",
              "sourceAngularVelocity"
            ],
            "changed": true
          }
        ]
      }
    },
    {
      "id": "wristOffShoulder28",
      "family": "multiStep",
      "domain": "robotics",
      "style": "multiPart",
      "split": "test",
      "model": "articulatedRoboticArm",
      "request": "Disable the wrist motor and the wrist link, and set the shoulder supply to 28 V.",
      "expect": {
        "touches": [
          "Wrist motor",
          "Wrist link",
          "Shoulder supply"
        ],
        "assertions": [
          {
            "op": "enabled",
            "node": "Wrist motor",
            "value": false
          },
          {
            "op": "enabled",
            "node": "Wrist link",
            "value": false
          },
          {
            "op": "state",
            "node": "Shoulder supply",
            "symbol": "voltage",
            "initialValue": 28,
            "unit": "V"
          }
        ]
      }
    },
    {
      "id": "removeWristAssembly",
      "family": "remove",
      "domain": "robotics",
      "style": "verbose",
      "split": "test",
      "model": "articulatedRoboticArm",
      "request": "We are dropping the wrist from the design, so remove the whole wrist assembly: the supply, the motor and the link.",
      "expect": {
        "touches": [
          "Wrist supply",
          "Wrist motor",
          "Wrist link"
        ],
        "assertions": [
          {
            "op": "removed",
            "node": "Wrist supply"
          },
          {
            "op": "removed",
            "node": "Wrist motor"
          },
          {
            "op": "removed",
            "node": "Wrist link"
          }
        ]
      }
    },
    {
      "id": "gripper",
      "family": "addNode",
      "domain": "robotics",
      "style": "plain",
      "split": "test",
      "model": "blank",
      "request": "Add a rotational link called Gripper with an angle of 0 rad and an angular velocity of 0 rad/s.",
      "expect": {
        "touches": [],
        "assertions": [
          {
            "op": "nodesAdded",
            "count": 1
          },
          {
            "op": "hasNode",
            "name": "Gripper"
          },
          {
            "op": "state",
            "node": "Gripper",
            "initialValue": 0,
            "unit": "rad"
          },
          {
            "op": "state",
            "node": "Gripper",
            "initialValue": 0,
            "unit": "rad/s"
          }
        ]
      }
    },
    {
      "id": "wristCameraMount",
