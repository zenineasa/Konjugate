  "cases": [
    {
      "id": "setpoint2",
      "family": "updateParameter",
      "domain": "robotics",
      "style": "plain",
      "split": "test",
      "model": "positionControlledJoint",
      "request": "Set the position setpoint to 2 rad.",
      "expect": {
        "touches": [
          "Position control"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Joint link",
            "to": "Voltage source",
            "symbol": "setpointAngle",
            "value": 2,
            "unit": "rad"
          }
        ]
      }
    },
    {
      "id": "positionGain8",
      "family": "updateParameter",
      "domain": "robotics",
      "style": "terse",
      "split": "test",
      "model": "positionControlledJoint",
      "request": "Position gain 8.",
      "expect": {
        "touches": [
          "Position control"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Joint link",
            "to": "Voltage source",
            "symbol": "gain",
            "value": 8
          }
        ]
      }
    },
    {
      "id": "elbowWristSupplies",
      "family": "multiStep",
      "domain": "robotics",
      "style": "conversational",
      "split": "test",
      "model": "articulatedRoboticArm",
      "request": "Could the elbow supply run at 20 volts and the wrist supply at 15?",
      "expect": {
        "touches": [
          "Elbow supply",
          "Wrist supply"
        ],
        "assertions": [
          {
            "op": "state",
            "node": "Elbow supply",
            "symbol": "voltage",
            "initialValue": 20,
            "unit": "V"
          },
          {
            "op": "state",
            "node": "Wrist supply",
            "symbol": "voltage",
            "initialValue": 15,
            "unit": "V"
          }
        ]
      }
    },
    {
      "id": "shoulderInertia",
      "family": "updateParameter",
      "domain": "robotics",
      "style": "indirect",
      "split": "test",
      "model": "articulatedRoboticArm",
      "request": "The shoulder link is lighter in the model than in the real arm: the real moment of inertia is 0.04 kg·m².",
      "expect": {
        "touches": [
          "Shoulder rotational drive"
        ],
        "assertions": [
          {
            "op": "edgeParameter",
            "from": "Shoulder motor",
            "to": "Shoulder link",
            "symbol": "momentOfInertia",
            "value": 0.04
          }
        ]
      }
    },
    {
      "id": "killElbowMotor",
      "family": "enableDisable",
      "domain": "robotics",
      "style": "loose",
      "split": "test",
      "model": "articulatedRoboticArm",
      "request": "kill the elbow motor",
      "expect": {
        "touches": [
          "Elbow motor"
        ],
        "assertions": [
          {
            "op": "enabled",
            "node": "Elbow motor",
            "value": false
          }
        ]
      }
    },
    {
