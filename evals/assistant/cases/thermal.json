    {
      "id": "conductionEquation",
      "family": "setEquation",
      "domain": "thermal",
      "style": "verbose",
      "split": "test",
      "model": "thermalEquilibrium",
      "request": "The conduction between the hot body and the cold body should ignore the thermal capacitance for this test. Please change its equation to just the conductance times the temperature difference.",
      "expect": {
        "touches": [
          "Conduction"
        ],
        "assertions": [
          {
            "op": "edgeEquation",
            "from": "Hot body",
            "to": "Cold body",
            "uses": [
              "conductance"
            ],
            "excludes": [
              "thermalCapacitance"
            ],
            "changed": true
          }
        ]
      }
    },
